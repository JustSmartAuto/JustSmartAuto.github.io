<Window x:Class="JusPatInspect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JusPatInspect"
        mc:Ignorable="d"
        Title="PatInspect - 基于概率统计的图像差分检测" Height="850" Width="1400">
    <DockPanel>
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0">
            <MenuItem Header="文件">
                <MenuItem x:Name="MenuOpenImage" Header="打开图像" Click="MenuOpenImage_Click"/>
                <MenuItem x:Name="MenuSaveImage" Header="保存图像" Click="MenuSaveImage_Click"/>
                <MenuItem x:Name="MenuOpenFolder" Header="打开文件夹" Click="MenuOpenFolder_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuExit" Header="退出" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="训练">
                <MenuItem x:Name="MenuTrainNew" Header="训练新模式" Click="MenuTrainNew_Click"/>
                <MenuItem x:Name="MenuStatTrain" Header="统计训练当前模式" Click="MenuStatTrain_Click" IsEnabled="False"/>
                <MenuItem x:Name="MenuEndStatTrain" Header="结束统计训练" Click="MenuEndStatTrain_Click" IsEnabled="False"/>
                <MenuItem x:Name="MenuCancelTrain" Header="取消训练模式" Click="MenuCancelTrain_Click" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="MenuLoadPattern" Header="加载模式" Click="MenuLoadPattern_Click"/>
                <MenuItem x:Name="MenuSavePattern" Header="保存模式" Click="MenuSavePattern_Click"/>
            </MenuItem>
            <MenuItem Header="运行">
                <MenuItem x:Name="MenuRun" Header="运行检测" Click="MenuRun_Click"/>
                <MenuItem x:Name="MenuRunFolder" Header="批量检测文件夹" Click="MenuRunFolder_Click"/>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem x:Name="MenuAbout" Header="关于" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <ToolBarTray DockPanel.Dock="Top" Background="#F0F0F0">
            <ToolBar>
                <Button x:Name="BtnRun" Content="▶ 运行" ToolTip="运行检测" FontSize="12" Padding="8,3" Click="BtnRun_Click"/>
                <Button x:Name="BtnTrain" Content="⚡ 训练" ToolTip="训练新模式" FontSize="12" Padding="8,3" Click="BtnTrain_Click"/>
                <Separator/>
                <Button x:Name="BtnOpenImage" Content="🖼 打开" ToolTip="打开图像" FontSize="12" Padding="8,3" Click="BtnOpenImage_Click"/>
                <Button x:Name="BtnSaveImage" Content="💾 保存" ToolTip="保存图像" FontSize="12" Padding="8,3" Click="BtnSaveImage_Click"/>
                <Button x:Name="BtnOpenFolder" Content="📂 文件夹" ToolTip="打开文件夹" FontSize="12" Padding="8,3" Click="BtnOpenFolder_Click"/>
                <Separator/>
                <Button x:Name="BtnUndo" Content="↩ 撤销" ToolTip="撤销" FontSize="12" Padding="8,3" Click="BtnUndo_Click"/>
                <Button x:Name="BtnRedo" Content="↪ 重做" ToolTip="重做" FontSize="12" Padding="8,3" Click="BtnRedo_Click"/>
                <Separator/>
                <Button x:Name="BtnZoomIn" Content="🔍+" ToolTip="放大" FontSize="12" Padding="8,3" Click="BtnZoomIn_Click"/>
                <Button x:Name="BtnZoomOut" Content="🔍-" ToolTip="缩小" FontSize="12" Padding="8,3" Click="BtnZoomOut_Click"/>
                <Button x:Name="BtnFit" Content="⊡ 适应" ToolTip="适应窗口" FontSize="12" Padding="8,3" Click="BtnFit_Click"/>
                <Separator/>
                <Button x:Name="BtnHelp" Content="❓ 帮助" ToolTip="帮助" FontSize="12" Padding="8,3" Click="BtnHelp_Click"/>
            </ToolBar>
        </ToolBarTray>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Height="30">
            <TextBlock x:Name="StatusText" Text="未训练" FontWeight="Bold" Foreground="DarkRed" Margin="5,0"/>
            <Separator/>
            <TextBlock x:Name="TimeText" Text="0.0000毫秒" Margin="5,0"/>
            <Separator/>
            <TextBlock x:Name="ImageInfoText" Text="图像: 无" Margin="5,0"/>
            <Separator/>
            <TextBlock x:Name="TrainCountText" Text="训练图像数: 0" Margin="5,0"/>
            <Separator/>
            <TextBlock x:Name="MessageText" Text="就绪" Margin="10,0,0,0"/>
        </StatusBar>

        <!-- 主内容区 -->
        <TabControl x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
            <!-- 训练参数 Tab -->
            <TabItem Header="训练参数">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 左侧参数面板 -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <!-- 已训练的模式图像 -->
                            <GroupBox Header="已训练的模式图像" Margin="0,5">
                                <Border x:Name="PatternImageBorder" Height="200" Background="#333333" Margin="5" 
                                        BorderBrush="Gray" BorderThickness="1">
                                    <Image x:Name="PatternImage" Stretch="Uniform"/>
                                </Border>
                            </GroupBox>
                            
                            <!-- 按钮行 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                                <Button x:Name="BtnLoadPattern" Content="加载模式" Width="100" Margin="5" Padding="5,3" Click="BtnLoadPattern_Click"/>
                                <Button x:Name="BtnSavePattern" Content="保存模式" Width="100" Margin="5" Padding="5,3" Click="BtnSavePattern_Click"/>
                            </StackPanel>
                            
                            <TextBlock x:Name="TrainedRegionText" Text="已经过统计训练的区域: 0" HorizontalAlignment="Center" Margin="0,5"/>
                            
                            <!-- 单个图像模式 -->
                            <GroupBox Header="单个图像模式 (Sobel边缘检测)" Margin="0,5">
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Sobel 缩放:" VerticalAlignment="Center" Margin="0,3"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="SobelScaleText" Text="1.0" Width="80" Margin="0,3" TextChanged="SobelScaleText_TextChanged"/>
                                        <Button Content="▲" Width="22" Height="22" Margin="2,0" Click="SobelScaleUp_Click"/>
                                        <Button Content="▼" Width="22" Height="22" Margin="2,0" Click="SobelScaleDown_Click"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sobel 偏移:" VerticalAlignment="Center" Margin="0,3"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="SobelOffsetText" Text="0" Width="80" Margin="0,3" TextChanged="SobelOffsetText_TextChanged"/>
                                        <Button Content="▲" Width="22" Height="22" Margin="2,0" Click="SobelOffsetUp_Click"/>
                                        <Button Content="▼" Width="22" Height="22" Margin="2,0" Click="SobelOffsetDown_Click"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            
                            <!-- 已经过统计训练的模式 -->
                            <GroupBox Header="统计训练模式 (阈值参数)" Margin="0,5">
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="阈值比例 (A):" VerticalAlignment="Center" Margin="0,3"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="ThresholdScaleText" Text="2.0" Width="80" Margin="0,3" TextChanged="ThresholdScaleText_TextChanged"/>
                                        <Button Content="▲" Width="22" Height="22" Margin="2,0" Click="ThresholdScaleUp_Click"/>
                                        <Button Content="▼" Width="22" Height="22" Margin="2,0" Click="ThresholdScaleDown_Click"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="阈值偏移 (B):" VerticalAlignment="Center" Margin="0,3"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="ThresholdOffsetText" Text="10" Width="80" Margin="0,3" TextChanged="ThresholdOffsetText_TextChanged"/>
                                        <Button Content="▲" Width="22" Height="22" Margin="2,0" Click="ThresholdOffsetUp_Click"/>
                                        <Button Content="▼" Width="22" Height="22" Margin="2,0" Click="ThresholdOffsetDown_Click"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            
                            <!-- 插值法 -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="插值法:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="InterpolationCombo" SelectedIndex="0" SelectionChanged="InterpolationCombo_SelectionChanged">
                                    <ComboBoxItem Content="Bilinear (双线性)"/>
                                    <ComboBoxItem Content="NearestNeighbor (最近邻)"/>
                                    <ComboBoxItem Content="Bicubic (双三次)"/>
                                </ComboBox>
                            </Grid>
                            
                            <!-- 操作按钮 -->
                            <Button x:Name="BtnGrabTrainImage" Content="抓取训练图像与原点" Margin="0,5" Padding="8,5" Click="BtnGrabTrainImage_Click"/>
                            <Button x:Name="BtnTrainNew" Content="训练新模式" Margin="0,5" Padding="8,5" Click="BtnTrainNew_Click"/>
                            <Button x:Name="BtnStatTrain" Content="统计训练当前模式" Margin="0,5" Padding="8,5" IsEnabled="False" Click="BtnStatTrain_Click"/>
                            <Button x:Name="BtnEndStatTrain" Content="结束统计训练" Margin="0,5" Padding="8,5" IsEnabled="False" Click="BtnEndStatTrain_Click"/>
                            <Button x:Name="BtnCancelTrain" Content="取消训练模式" Margin="0,5" Padding="8,5" IsEnabled="False" Click="BtnCancelTrain_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- 右侧图像显示 -->
                    <GroupBox Grid.Column="1" Header="当前输入图像">
                        <Border Background="#1a1a2e" Margin="5">
                            <Grid>
                                <Image x:Name="TrainParamImage" Stretch="Uniform" MouseWheel="Image_MouseWheel"
                                       MouseLeftButtonDown="Image_MouseLeftButtonDown"
                                       MouseMove="Image_MouseMove"
                                       MouseLeftButtonUp="Image_MouseLeftButtonUp"/>
                                <Canvas x:Name="TrainParamOverlay" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 训练区域与原点 Tab -->
            <TabItem Header="训练区域与原点">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 左侧参数面板 -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- 训练区域 -->
                                <GroupBox Grid.Column="0" Header="训练区域" Margin="0,5,5,5">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="区域模式:" Margin="0,3"/>
                                        <ComboBox x:Name="RegionModeCombo" SelectedIndex="0" SelectionChanged="RegionModeCombo_SelectionChanged">
                                            <ComboBoxItem Content="AffineTransform"/>
                                            <ComboBoxItem Content="Transform"/>
                                            <ComboBoxItem Content="None"/>
                                        </ComboBox>
                                        
                                        <TextBlock Text="区域形状:" Margin="0,5,3,0"/>
                                        <ComboBox x:Name="RegionShapeCombo" SelectedIndex="0" SelectionChanged="RegionShapeCombo_SelectionChanged">
                                            <ComboBoxItem Content="CogRectangleAffine"/>
                                            <ComboBoxItem Content="CogRectangle"/>
                                            <ComboBoxItem Content="CogCircle"/>
                                            <ComboBoxItem Content="CogEllipse"/>
                                        </ComboBox>
                                        
                                        <TextBlock Text="所选空间名称:" Margin="0,5,3,0"/>
                                        <ComboBox x:Name="SpaceNameCombo" SelectedIndex="0">
                                            <ComboBoxItem Content="* - 使用输入图像空间"/>
                                            <ComboBoxItem Content="@ - 像素空间"/>
                                        </ComboBox>
                                        
                                        <TextBlock Text="选择模式:" Margin="0,5,3,0"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="SelectOriginRadio" Content="原点" IsChecked="True" Margin="0,0,10,0" Checked="SelectMode_Checked"/>
                                            <RadioButton x:Name="SelectCenterRadio" Content="中心" Margin="0,0,10,0" Checked="SelectMode_Checked"/>
                                            <RadioButton x:Name="Select3PointRadio" Content="3 点" Checked="SelectMode_Checked"/>
                                        </StackPanel>
                                        
                                        <TextBlock Text="原点 X:" Margin="0,5,3,0"/>
                                        <TextBox x:Name="OriginXText" Text="0" TextChanged="OriginXText_TextChanged"/>
                                        
                                        <TextBlock Text="原点 Y:" Margin="0,5,3,0"/>
                                        <TextBox x:Name="OriginYText" Text="0" TextChanged="OriginYText_TextChanged"/>
                                        
                                        <TextBlock Text="边长 X:" Margin="0,5,3,0"/>
                                        <TextBox x:Name="SideXText" Text="100" TextChanged="SideXText_TextChanged"/>
                                        
                                        <TextBlock Text="边长 Y:" Margin="0,5,3,0"/>
                                        <TextBox x:Name="SideYText" Text="100" TextChanged="SideYText_TextChanged"/>
                                        
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="旋转:" Grid.Column="0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="RotationText" Grid.Column="1" Text="0" TextChanged="RotationText_TextChanged"/>
                                            <TextBlock Text="deg" Grid.Column="2" VerticalAlignment="Center" Margin="5,0"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="倾斜:" Grid.Column="0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="SkewText" Grid.Column="1" Text="0" TextChanged="SkewText_TextChanged"/>
                                            <TextBlock Text="deg" Grid.Column="2" VerticalAlignment="Center" Margin="5,0"/>
                                        </Grid>
                                        
                                        <Button x:Name="BtnFitToImage" Content="适应图像" Margin="0,10,0,0" Padding="5,3" Click="BtnFitToImage_Click"/>
                                    </StackPanel>
                                </GroupBox>
                                
                                <!-- 训练原点 -->
                                <GroupBox Grid.Column="1" Header="训练原点 (Pose)" Margin="5,5,0,5">
                                    <StackPanel Margin="5">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="平移 X:" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TranslateXText" Grid.Column="1" Text="0" TextChanged="TranslateXText_TextChanged"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="平移 Y:" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TranslateYText" Grid.Column="1" Text="0" TextChanged="TranslateYText_TextChanged"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="缩放:" VerticalAlignment="Center"/>
                                            <TextBox x:Name="ScaleText" Grid.Column="1" Text="1" TextChanged="ScaleText_TextChanged"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="纵横比:" VerticalAlignment="Center"/>
                                            <TextBox x:Name="AspectRatioText" Grid.Column="1" Text="1" TextChanged="AspectRatioText_TextChanged"/>
                                            <TextBlock Text="Y/X" Grid.Column="2" VerticalAlignment="Center" Margin="5,0"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="旋转:" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TrainRotationText" Grid.Column="1" Text="0" TextChanged="TrainRotationText_TextChanged"/>
                                            <TextBlock Text="deg" Grid.Column="2" VerticalAlignment="Center" Margin="5,0"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="倾斜:" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TrainSkewText" Grid.Column="1" Text="0" TextChanged="TrainSkewText_TextChanged"/>
                                            <TextBlock Text="deg" Grid.Column="2" VerticalAlignment="Center" Margin="5,0"/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- 右侧图像显示 -->
                    <GroupBox Grid.Column="1" Header="当前输入图像 (带区域标记)">
                        <Border Background="#1a1a2e" Margin="5">
                            <Grid>
                                <Image x:Name="RegionImage" Stretch="Uniform" MouseWheel="Image_MouseWheel"
                                       MouseLeftButtonDown="Image_MouseLeftButtonDown"
                                       MouseMove="Image_MouseMove"
                                       MouseLeftButtonUp="Image_MouseLeftButtonUp"/>
                                <Canvas x:Name="RegionOverlay" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 运行参数 Tab -->
            <TabItem Header="运行参数">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 左侧参数面板 -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <!-- 规范化 -->
                            <GroupBox Header="图像归一化 (Normalization)" Margin="0,5">
                                <StackPanel Margin="5">
                                    <TextBlock Text="归一化模式:" Margin="0,3"/>
                                    <ComboBox x:Name="NormalizeModeCombo" SelectedIndex="1" SelectionChanged="NormalizeModeCombo_SelectionChanged">
                                        <ComboBoxItem Content="Identity (无归一化)"/>
                                        <ComboBoxItem Content="HistogramEqualization (直方图均衡化)"/>
                                        <ComboBoxItem Content="MeanAndStdDev (均值标准差)"/>
                                        <ComboBoxItem Content="MatchTails (匹配尾部)"/>
                                        <ComboBoxItem Content="RobustLineFit (稳健线性拟合)"/>
                                        <ComboBoxItem Content="LocalCorrection (局部校正)"/>
                                        <ComboBoxItem Content="EnhancedLocalCorrection (增强局部校正)"/>
                                    </ComboBox>
                                    
                                    <!-- 局部校正参数 -->
                                    <Grid x:Name="LocalCorrectionParams" Visibility="Collapsed" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="邻域宽度:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NeighborhoodWidthText" Text="32"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="邻域高度:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NeighborhoodHeightText" Text="32" Margin="0,5,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                            
                            <!-- 匹配图像 -->
                            <GroupBox Header="匹配图像输出" Margin="0,5">
                                <StackPanel Margin="5">
                                    <CheckBox x:Name="GenNonNormalizedCheck" Content="生成非规范化匹配图像" IsChecked="True" Margin="0,3"/>
                                    <CheckBox x:Name="GenNormalizedCheck" Content="生成规范化匹配图像" Margin="0,3"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <!-- 阈值处理的差异图像 -->
                            <GroupBox Header="阈值处理的差异图像 (检测结果)" Margin="0,5">
                                <StackPanel Margin="5">
                                    <CheckBox x:Name="GenAbsDiffCheck" Content="生成绝对差异图像" IsChecked="True" Margin="0,3"/>
                                    <CheckBox x:Name="GenBrightDiffCheck" Content="生成较亮差异图像 (缺陷更亮)" Margin="0,3"/>
                                    <CheckBox x:Name="GenDarkDiffCheck" Content="生成较暗差异图像 (缺陷更暗)" Margin="0,3"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <!-- 原始差异图像 -->
                            <GroupBox Header="原始差异图像 (调试用)" Margin="0,5">
                                <StackPanel Margin="5">
                                    <CheckBox x:Name="GenRawAbsDiffCheck" Content="生成绝对差异图像" IsChecked="True" Margin="0,3"/>
                                    <CheckBox x:Name="GenRawBrightDiffCheck" Content="生成较亮差异图像" Margin="0,3"/>
                                    <CheckBox x:Name="GenRawDarkDiffCheck" Content="生成较暗差异图像" Margin="0,3"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <!-- 缺陷统计 -->
                            <GroupBox Header="缺陷统计信息" Margin="0,5">
                                <StackPanel Margin="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="缺陷像素数:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="DefectPixelCountText" Text="0" IsReadOnly="True" Background="#F0F0F0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="缺陷比例:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DefectRatioText" Text="0.00%" IsReadOnly="True" Background="#F0F0F0" Margin="0,5,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="平均缺陷强度:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="AvgDefectIntensityText" Text="0" IsReadOnly="True" Background="#F0F0F0" Margin="0,5,0,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="最大缺陷强度:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="MaxDefectIntensityText" Text="0" IsReadOnly="True" Background="#F0F0F0" Margin="0,5,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- 右侧图像显示 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <GroupBox Grid.Row="0" Grid.Column="0" Header="输入图像">
                            <Border Background="#1a1a2e" Margin="2">
                                <Image x:Name="RunParamImage" Stretch="Uniform"/>
                            </Border>
                        </GroupBox>
                        
                        <GroupBox Grid.Row="0" Grid.Column="1" Header="匹配图像">
                            <Border Background="#1a1a2e" Margin="2">
                                <Image x:Name="MatchImage" Stretch="Uniform"/>
                            </Border>
                        </GroupBox>
                        
                        <GroupBox Grid.Row="1" Grid.Column="0" Header="原始差异图像">
                            <Border Background="#1a1a2e" Margin="2">
                                <Image x:Name="RawDiffImage" Stretch="Uniform"/>
                            </Border>
                        </GroupBox>
                        
                        <GroupBox Grid.Row="1" Grid.Column="1" Header="阈值处理差异图像 (缺陷检测结果)">
                            <Border Background="#1a1a2e" Margin="2">
                                <Image x:Name="ThresholdDiffImage" Stretch="Uniform"/>
                            </Border>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 图形 Tab -->
            <TabItem Header="图形">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 左侧参数面板 -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <!-- 输入 -->
                            <GroupBox Header="输入显示选项" Margin="0,5">
                                <StackPanel Margin="5">
                                    <CheckBox x:Name="ShowTrainMaskCheck" Content="显示训练图像掩模" IsChecked="True" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <!-- 已训练的图像 -->
                            <GroupBox Header="已训练图像显示选项" Margin="0,5">
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Row="0" Grid.Column="0" x:Name="ShowPatternCheck" Content="显示模式图像" IsChecked="True" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" x:Name="ShowThresholdCheck" Content="显示阈值图像" IsChecked="True" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="0" x:Name="ShowStdDevCheck" Content="显示标准差图像" IsChecked="False" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="ShowOriginCheck" Content="显示原点" IsChecked="True" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                    <CheckBox Grid.Row="2" Grid.Column="0" x:Name="ShowRegionCheck" Content="显示区域" IsChecked="True" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ShowMaskCheck" Content="显示掩模" IsChecked="True" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                </Grid>
                            </GroupBox>
                            
                            <!-- 结果 -->
                            <GroupBox Header="结果显示选项" Margin="0,5">
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Row="0" Grid.Column="0" x:Name="ShowMatchCheck" Content="显示匹配图像" IsChecked="True" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" x:Name="ShowCroppedMaskCheck" Content="显示裁切的掩模" IsChecked="True" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="0" x:Name="ShowDiffCheck" Content="显示差异图像" IsChecked="True" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="ShowDiffAsGraphicCheck" Content="差异叠加显示" IsChecked="True" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                    <CheckBox Grid.Row="2" Grid.Column="0" x:Name="ShowRawDiffCheck" Content="显示原始差异图像" IsChecked="True" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ShowDefectOverlayCheck" Content="缺陷叠加显示" IsChecked="True" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                </Grid>
                            </GroupBox>
                            
                            <!-- 诊断 -->
                            <GroupBox Header="诊断显示选项 (重新运行以查看效果)" Margin="0,5">
                                <StackPanel Margin="5">
                                    <TextBlock Text="显示输入图像:" Margin="0,3"/>
                                    <StackPanel Orientation="Horizontal" Margin="10,0">
                                        <RadioButton x:Name="NoCopyRadio" Content="不带副本" IsChecked="True" Margin="0,0,20,0" Checked="DiagOption_CheckedChanged"/>
                                        <RadioButton x:Name="WithCopyRadio" Content="带副本" Margin="0,0,20,0" Checked="DiagOption_CheckedChanged"/>
                                        <RadioButton x:Name="NoneRadio" Content="无" Checked="DiagOption_CheckedChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10">
                                        <CheckBox x:Name="ShowMorphologyCheck" Content="显示形态" Margin="0,0,20,0" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                        <CheckBox x:Name="ShowDiagRegionCheck" Content="显示区域" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowMaskOnResultCheck" Content="在结果图像上显示掩模" Margin="0,3" Checked="ShowOption_CheckedChanged" Unchecked="ShowOption_CheckedChanged"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <!-- 颜色设置 -->
                            <GroupBox Header="缺陷显示颜色" Margin="0,5">
                                <StackPanel Margin="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="缺陷颜色:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DefectColorCombo" SelectedIndex="0" SelectionChanged="DefectColorCombo_SelectionChanged">
                                            <ComboBoxItem Content="红色"/>
                                            <ComboBoxItem Content="绿色"/>
                                            <ComboBoxItem Content="蓝色"/>
                                            <ComboBoxItem Content="黄色"/>
                                            <ComboBoxItem Content="白色"/>
                                        </ComboBox>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="透明度:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        <Slider Grid.Row="1" Grid.Column="1" x:Name="DefectOpacitySlider" Minimum="0" Maximum="1" Value="0.7" Margin="0,5,0,0" ValueChanged="DefectOpacitySlider_ValueChanged"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- 右侧图像显示 -->
                    <GroupBox Grid.Column="1" Header="综合显示">
                        <Border Background="#1a1a2e" Margin="5">
                            <Grid>
                                <Image x:Name="GraphicsImage" Stretch="Uniform" MouseWheel="Image_MouseWheel"
                                       MouseLeftButtonDown="Image_MouseLeftButtonDown"
                                       MouseMove="Image_MouseMove"
                                       MouseLeftButtonUp="Image_MouseLeftButtonUp"/>
                                <Canvas x:Name="GraphicsOverlay" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </GroupBox>
                </Grid>
            </TabItem>
            
            <!-- 批量处理 Tab -->
            <TabItem Header="批量处理">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 左侧参数面板 -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <GroupBox Header="批量处理设置" Margin="0,5">
                                <StackPanel Margin="5">
                                    <TextBlock Text="输入文件夹:" Margin="0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BatchInputFolderText" Grid.Column="0" IsReadOnly="True" Background="#F0F0F0"/>
                                        <Button x:Name="BtnBrowseInput" Grid.Column="1" Content="浏览..." Margin="5,0,0,0" Click="BtnBrowseInput_Click"/>
                                    </Grid>
                                    
                                    <TextBlock Text="输出文件夹:" Margin="0,10,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BatchOutputFolderText" Grid.Column="0" IsReadOnly="True" Background="#F0F0F0"/>
                                        <Button x:Name="BtnBrowseOutput" Grid.Column="1" Content="浏览..." Margin="5,0,0,0" Click="BtnBrowseOutput_Click"/>
                                    </Grid>
                                    
                                    <CheckBox x:Name="SaveDiffImageCheck" Content="保存差异图像" IsChecked="True" Margin="0,10,0,0"/>
                                    <CheckBox x:Name="SaveResultImageCheck" Content="保存结果图像" IsChecked="True" Margin="0,5,0,0"/>
                                    <CheckBox x:Name="SaveReportCheck" Content="保存检测报告" IsChecked="True" Margin="0,5,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <GroupBox Header="缺陷判定阈值" Margin="0,5">
                                <StackPanel Margin="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最大允许缺陷像素数:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="MaxDefectPixelsText" Text="1000"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最大允许缺陷比例:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MaxDefectRatioText" Text="1.0%" Margin="0,5,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                            
                            <Button x:Name="BtnStartBatch" Content="开始批量处理" Margin="0,10" Padding="10,5" Click="BtnStartBatch_Click"/>
                            <Button x:Name="BtnStopBatch" Content="停止处理" Margin="0,5" Padding="10,5" IsEnabled="False" Click="BtnStopBatch_Click"/>
                            
                            <ProgressBar x:Name="BatchProgressBar" Height="20" Margin="0,10" Minimum="0" Maximum="100" Value="0"/>
                            
                            <TextBlock x:Name="BatchStatusText" Text="就绪" Margin="0,5"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- 右侧结果显示 -->
                    <GroupBox Grid.Column="1" Header="批量处理结果">
                        <DataGrid x:Name="BatchResultGrid" Margin="5" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/>
                                <DataGridTextColumn Header="缺陷像素数" Binding="{Binding DefectPixelCount}" Width="100"/>
                                <DataGridTextColumn Header="缺陷比例" Binding="{Binding DefectRatio}" Width="100"/>
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="80"/>
                                <DataGridTextColumn Header="处理时间" Binding="{Binding ProcessTime}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
